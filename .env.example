# ─── Development vs Production mode ────────────────
# NODE_ENV decides whether paid third-party services (Midtrans, Vercel,
# v0.dev, Contabo) fall back to a local mock/simulation when their
# credential below is missing:
#   - NODE_ENV=production (the default under `bun run build`/`start`):
#     mocking is NEVER used, even with no credential — the real call is
#     attempted and fails loudly so a misconfigured deploy is caught.
#   - NODE_ENV=development (the default under `bun run dev`) or `test`
#     (set automatically by Vitest): any of these services with no
#     credential configured falls back to an in-process mock, so the full
#     app — including the payment flow — can be exercised end to end with
#     none of these paid subscriptions. See src/lib/dev-mode.ts.
# Cloudflare R2/S3 storage is the one exception: it always falls back to
# real local-disk storage (not a mock) regardless of NODE_ENV, so it needs
# no credential in any environment — see src/lib/r2.ts.

# Database
DATABASE_URL="postgresql://sacms:Z0ngg0n4U@postgres:5432/sacms?pgbouncer=true"
DIRECT_URL="postgresql://sacms:Z0ngg0n4U@postgres:5432/sacms"
POSTGRES_PASSWORD="Z0ngg0n4U"

# ─── Self-Hosted Mode ──────────────────────────────
# Set to "true" to run SaCMS as a self-hosted single-tenant CMS
# This disables: landing page, SaaS billing, admin panel
# Only /dashboard/* routes and public APIs are active
SELFHOST_MODE="true"

# ─── Enterprise License (Self-Hosted) ──────────────
# Optional: Activate enterprise features (unlimited everything)
LICENSE_KEY=""
LICENSE_SERVER_URL="https://license.sacms.cloud"


# NextAuth
NEXTAUTH_SECRET="generate-a-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Email Delivery (Resend or SMTP)
RESEND_API_KEY=""
RESEND_FROM="SaCMS <noreply@sacms.local>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
SMTP_FROM="SaCMS <noreply@sacms.local>"

# OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Redis (optional — falls back to in-memory)
REDIS_URL="redis://localhost:6379"

# Custom Domain Verification (optional — recommended for production)
# Used to sign the TXT-record ownership-verification token with HMAC-SHA256
# instead of the weaker built-in fallback. Set a long random value.
DOMAIN_VERIFY_SECRET=""

# Cloudflare R2 / S3 Storage
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
S3_PUBLIC_URL=""

# Payment Gateway (midtrans | mock)
# "mock" forces the in-memory mock payment provider even if a real
# MIDTRANS_SERVER_KEY is set — for local checkout testing with no live
# Midtrans. Ignored in production. With no MIDTRANS_SERVER_KEY the mock is
# used automatically outside production regardless of this value; and if a
# real Midtrans call just times out in dev, it also falls back to the mock.
PAYMENT_PROVIDER="midtrans"

# Midtrans Payment
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
NEXT_PUBLIC_MIDTRANS_SNAP_URL="https://app.sandbox.midtrans.com/snap/snap.js"

# Cron Jobs
CRON_SECRET="generate-a-cron-secret"

# OpenAI (optional — enables AI content generation)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# v0.dev AI Frontend Builder (optional — enables AI website generation)
V0_API_KEY=""

# App URL (used by Frontend Builder for CMS API references)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Sentry Error Monitoring (optional)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# ─── Enterprise Infrastructure Provisioning (Contabo VPS + PG + MinIO) ───
CONTABO_CLIENT_ID=""
CONTABO_CLIENT_SECRET=""
CONTABO_API_USER=""
CONTABO_API_PASSWORD=""
CONTABO_AUTH_URL="https://auth.contabo.com/auth/realms/contabo/protocol/openid-connect/token"
CONTABO_API_URL="https://api.contabo.com/v1/compute/instances"

CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""
INFRA_BASE_DOMAIN="sacms.cloud"
INFRA_ENCRYPTION_KEY=""

