generator client {
  provider      = "prisma-client-js"
  output        = "./generated-client"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String         @id @default(cuid())
  email               String         @unique
  name                String?
  password            String?
  image               String?
  role                String         @default("owner")
  ownerSlug           String?        @unique
  emailVerified       DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  plan                String         @default("free")
  aiCreditsUsed       Int            @default(0)
  aiCreditsExtra      Int            @default(0)
  masterDatabaseUrl   String?
  masterStorageConfig Json?
  accounts            Account[]
  sessions            Session[]
  subscriptions       Subscription[]
  tenants             TenantMember[]
  ownedTenants        Tenant[]       @relation("OwnerTenants")
  aiQuotaLedgers      AiQuotaLedger[]
  supportTickets      SupportTicket[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Tenant {
  id                     String                        @id @default(cuid())
  name                   String
  slug                   String                        @unique
  description            String?
  logo                   String?
  plan                   String                        @default("free")
  status                 String                        @default("active")
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  ownerId                String?
  owner                  User?                         @relation("OwnerTenants", fields: [ownerId], references: [id], onDelete: SetNull)
  brandLogo              String?
  brandName              String?
  customDomain           String?                       @unique
  customDomainStatus     String?
  customDomainVerifiedAt DateTime?
  customEmailSender      String?
  databaseUrl            String?
  licenseKey             String?                       @unique
  faviconUrl             String?
  primaryColor           String?
  storageConfig          Json?
  hostingStatus          String?                       @default("trial")
  hostingExpiresAt       DateTime?
  vercelProjectId        String?
  vercelDeploymentUrl    String?
  aiTokensUsed           Int                           @default(0)
  aiCreditsExtra         Int                           @default(0)
  storageExtraBytes      BigInt                        @default(0)
  apiCallsExtra          Int                           @default(0)
  // Headless member auth policy
  allowMemberRegistration        Boolean               @default(true)
  requireMemberEmailVerification Boolean               @default(false)
  /// Exact origins allowed to call the credential-issuing auth endpoints with CORS.
  /// Empty = fall back to the tenant's own domains (+ localhost in dev).
  allowedAuthOrigins             String[]              @default([])
  /// Where the member email-verification link should point (the developer's own
  /// frontend). The one-time code is appended as `?code=<token>`. Empty = use the
  /// SaCMS-hosted fallback confirmation page.
  memberEmailConfirmationRedirect String?
  /// Where the member password-reset link should point. `?code=<token>` is
  /// appended. Empty = SaCMS-hosted fallback reset page.
  memberPasswordResetRedirect     String?
  apiKeys                ApiKey[]
  apiRequests            ApiRequest[]
  apiTokens              ApiToken[]
  auditLogs              AuditLog[]
  components             Component[]
  contentEntries         ContentEntry[]
  contentTypes           ContentType[]
  media                  Media[]
  mediaFolders           MediaFolder[]
  settings               Setting[]
  singleTypes            SingleType[]
  subscriptions          Subscription[]
  componentAssignments   TenantComponentAssignment[]
  contentTypeAssignments TenantContentTypeAssignment[]
  locales                TenantLocale[]
  members                TenantMember[]
  singleTypeAssignments  TenantSingleTypeAssignment[]
  webhooks               Webhook[]
  aiQuotaLedgers         AiQuotaLedger[]
  customDomains          CustomDomain[]
  oauthClients           OAuthClient[]
  oauthCodes             OAuthCode[]
  oauthTokens            OAuthToken[]
  sites                  Site[]
  infrastructureServers  InfrastructureServer[]
  supportTickets         SupportTicket[]
  appMembers             Member[]
  memberRoles            MemberRole[]

  @@map("tenants")
}

model TenantMember {
  id                String   @id @default(cuid())
  tenantId          String
  userId            String
  role              String   @default("subscriber")
  joinedAt          DateTime @default(now())
  customPermissions Json?
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@map("tenant_members")
}

model CustomPlanOverride {
  id                String   @id @default(cuid())
  userId            String?  @unique
  tenantId          String?  @unique
  maxWorkspaces     Int?
  maxContentTypes   Int?
  maxContentEntries Int?
  maxTeamMembers    Int?
  maxStorage        Int?
  maxLocales        Int?
  maxApiCalls       Int?
  maxAiTokens       Int?
  maxAiCredits      Int?
  maxCustomDomains  Int?
  note              String?
  createdBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("custom_plan_overrides")
}

model ContentType {
  id              String                        @id @default(cuid())
  name            String
  slug            String
  description     String?
  isPublished     Boolean                       @default(false)
  showInCms       Boolean                       @default(true)
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
  tenantId        String?
  docxTemplateUrl String?
  entries         ContentEntry[]
  schemaFields    SchemaField[]
  tenant          Tenant?                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenants         TenantContentTypeAssignment[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("content_types")
}

model SchemaField {
  id            String      @id @default(cuid())
  name          String
  slug          String
  type          String
  required      Boolean     @default(false)
  unique        Boolean     @default(false)
  order         Int         @default(0)
  jsonPath      String?
  localizable   Boolean     @default(true)
  relationSlug  String?
  options       Json?

  // Polymorphic relations
  contentTypeId String?
  contentType   ContentType? @relation(fields: [contentTypeId], references: [id], onDelete: Cascade)
  
  singleTypeId  String?
  singleType    SingleType?  @relation(fields: [singleTypeId], references: [id], onDelete: Cascade)
  
  componentId   String?
  component     Component?   @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([contentTypeId, slug])
  @@unique([singleTypeId, slug])
  @@unique([componentId, slug])
  @@map("schema_fields")
}

model AiQuotaLedger {
  id          String   @id @default(cuid())
  tenantId    String?
  userId      String?
  action      String
  tokens      Int      @default(0)
  credits     Int      @default(0)
  words       Int      @default(0)
  model       String?
  createdAt   DateTime @default(now())
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("ai_quota_ledgers")
}

model TenantContentTypeAssignment {
  id            String      @id @default(cuid())
  tenantId      String?
  contentTypeId String
  enabled       Boolean     @default(true)
  createdAt     DateTime    @default(now())
  contentType   ContentType @relation(fields: [contentTypeId], references: [id], onDelete: Cascade)
  tenant        Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, contentTypeId])
  @@map("tenant_content_type_assignments")
}

model ContentEntry {
  id                String                    @id @default(cuid())
  contentTypeId     String
  tenantId          String?
  publishedAt       DateTime?
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  archivedAt        DateTime?
  locale            String                    @default("id")
  reviewComment     String?
  scheduledAt       DateTime?
  status            ContentStatus             @default(DRAFT)
  searchVector      Unsupported("tsvector")?
  data              Json
  documentId        String?
  contentType       ContentType               @relation(fields: [contentTypeId], references: [id], onDelete: Cascade)
  tenant            Tenant?                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reviewAssignments ContentReviewAssignment[]
  versions          ContentVersion[]

  @@index([documentId])
  @@index([tenantId, contentTypeId, status])
  @@index([tenantId, locale])
  @@index([status, scheduledAt])
  @@index([tenantId, status])
  @@map("content_entries")
}

model ContentVersion {
  id             String       @id @default(cuid())
  contentEntryId String
  version        Int
  publishedAt    DateTime?
  changeType     String
  changedBy      String?
  changeSummary  String?
  createdAt      DateTime     @default(now())
  data           Json
  contentEntry   ContentEntry @relation(fields: [contentEntryId], references: [id], onDelete: Cascade)

  @@unique([contentEntryId, version])
  @@index([contentEntryId, createdAt])
  @@map("content_versions")
}

model ContentReviewAssignment {
  id             String       @id @default(cuid())
  contentEntryId String
  reviewerId     String
  reviewerName   String?
  order          Int          @default(0)
  status         String       @default("pending")
  comment        String?
  reviewedAt     DateTime?
  assignedBy     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  contentEntry   ContentEntry @relation(fields: [contentEntryId], references: [id], onDelete: Cascade)

  @@unique([contentEntryId, reviewerId])
  @@index([reviewerId, status])
  @@map("content_review_assignments")
}

model SingleType {
  id          String                       @id @default(cuid())
  name        String
  slug        String
  description String?
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt
  isPublished Boolean                      @default(false)
  showInCms   Boolean                      @default(true)
  tenantId    String?
  schemaFields SchemaField[]
  tenant      Tenant?                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenants     TenantSingleTypeAssignment[]

  @@unique([tenantId, slug])
  @@map("single_types")
}

model TenantSingleTypeAssignment {
  id           String     @id @default(cuid())
  tenantId     String?
  singleTypeId String
  enabled      Boolean    @default(true)
  publishedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  locale       String     @default("id")
  data         Json?
  singleType   SingleType @relation(fields: [singleTypeId], references: [id], onDelete: Cascade)
  tenant       Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, singleTypeId, locale])
  @@map("tenant_single_type_assignments")
}

model Component {
  id          String                      @id @default(cuid())
  name        String
  slug        String
  description String?
  category    String?
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  tenantId    String?
  schemaFields SchemaField[]
  tenant      Tenant?                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenants     TenantComponentAssignment[]

  @@unique([tenantId, slug])
  @@map("components")
}

model TenantComponentAssignment {
  id          String    @id @default(cuid())
  tenantId    String?
  componentId String
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, componentId])
  @@map("tenant_component_assignments")
}

model ApiKey {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  key         String    @unique
  lastUsed    DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  permissions Json?
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model Subscription {
  id                     String               @id @default(cuid())
  userId                 String
  tenantId               String?
  plan                   String
  status                 String               @default("active")
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean              @default(false)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  midtransCustomerId     String?
  midtransSubscriptionId String?
  invoices               Invoice[]
  paymentTransactions    PaymentTransaction[]
  tenant                 Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Invoice {
  id                String       @id @default(cuid())
  subscriptionId    String
  amount            Float
  currency          String       @default("IDR")
  status            String       @default("pending")
  paidAt            DateTime?
  createdAt         DateTime     @default(now())
  midtransInvoiceId String?
  subscription      Subscription @relation(fields: [subscriptionId], references: [id])

  @@map("invoices")
}

model PaymentTransaction {
  id              String        @id @default(cuid())
  subscriptionId  String?
  invoiceId       String?
  orderId         String        @unique
  paymentType     String?
  paymentMethod   String?
  amount          Float
  status          String
  transactionId   String?
  transactionTime DateTime?
  fraudStatus     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  rawResponse     Json?
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])

  @@map("payment_transactions")
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String?
  action    String
  entity    String
  entityId  String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  data      Json?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  tenantId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("settings")
}

model SystemMetric {
  id        String   @id @default(cuid())
  type      String
  value     Float
  timestamp DateTime @default(now())
  metadata  Json?

  @@map("system_metrics")
}

model ApiRequest {
  id         String   @id @default(cuid())
  tenantId   String?
  endpoint   String
  method     String
  statusCode Int
  duration   Int
  apiKeyId   String?
  createdAt  DateTime @default(now())
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("api_requests")
}

model MediaFolder {
  id        String        @id @default(cuid())
  tenantId  String
  name      String
  path      String
  parentId  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  media     Media[]
  parent    MediaFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  MediaFolder[] @relation("FolderHierarchy")
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, path])
  @@map("media_folders")
}

model Media {
  id           String       @id @default(cuid())
  tenantId     String
  folderId     String?
  name         String
  originalName String
  mimeType     String
  size         Int
  url          String
  thumbnailUrl String?
  alt          String?
  caption      String?
  width        Int?
  height       Int?
  uploadedBy   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  mediumUrl    String?
  storageKey   String?
  metadata     Json?
  isPrivate    Boolean      @default(false)
  folder       MediaFolder? @relation(fields: [folderId], references: [id])
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, mimeType])
  @@map("media")
}



model ApiToken {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  description String?
  token       String    @unique
  type        String    @default("read-only")
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  permissions Json?
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("api_tokens")
}

model Webhook {
  id              String              @id @default(cuid())
  tenantId        String
  name            String
  url             String
  secret          String?
  enabled         Boolean             @default(true)
  lastTriggeredAt DateTime?
  failureCount    Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  hookType        String              @default("async")
  events          Json
  headers         Json?
  deadLetters     WebhookDeadLetter[]
  logs            WebhookLog[]
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("webhooks")
}

model WebhookLog {
  id         String   @id @default(cuid())
  webhookId  String
  event      String
  statusCode Int?
  success    Boolean
  duration   Int?
  error      String?
  createdAt  DateTime @default(now())
  payload    Json
  response   Json?
  webhook    Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@map("webhook_logs")
}

model WebhookDeadLetter {
  id          String    @id @default(cuid())
  webhookId   String
  event       String
  payload     Json
  lastError   String?
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  nextRetryAt DateTime?
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  webhook     Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([status, nextRetryAt])
  @@index([webhookId])
  @@map("webhook_dead_letters")
}

model TenantLocale {
  id        String  @id @default(cuid())
  tenantId  String?
  locale    String
  name      String
  isDefault Boolean @default(false)
  isEnabled Boolean @default(true)
  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, locale])
  @@map("tenant_locales")
}



enum ContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
  REJECTED
}

// ─── Enterprise Self-Hosting ────────────────────────────────────────────

model EnterpriseLicense {
  id              String   @id @default(cuid())
  licenseKey      String   @unique
  customerName    String
  customerEmail   String?
  customerPhone   String?
  organization    String?
  type            String   @default("enterprise") // enterprise | partner | trial
  features        Json?    // ["self-host", "unlimited-workspaces", ...]
  maxInstances    Int      @default(1)
  issuedAt        DateTime @default(now())
  expiresAt       DateTime
  lastValidatedAt DateTime?
  validatedCount  Int      @default(0)
  status          String   @default("active")  // active | expired | revoked
  metadata        Json?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([licenseKey, status])
  @@index([expiresAt])
  @@map("enterprise_licenses")
}

model LicenseCache {
  id              String   @id @default("local-license")
  licenseKey      String
  customerName    String
  customerEmail   String?
  type            String
  features        Json?
  issuedAt        DateTime
  expiresAt       DateTime
  lastValidatedAt DateTime
  status          String
  updatedAt       DateTime @updatedAt

  @@map("license_cache")
}

model CustomDomain {
  id         String    @id @default(cuid())
  tenantId   String
  domain     String    @unique
  status     String    @default("pending") // pending, verified, failed
  verifiedAt DateTime?
  isPrimary  Boolean   @default(false)
  target     String    @default("cms") // cms | workspace | site | api
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("custom_domains")
}


// ─── OAuth 2.0 ─────────────────────────────────────────────────────────

model OAuthClient {
  id           String   @id @default(cuid())
  clientId     String   @unique
  clientSecret String?
  name         String
  redirectUris String[]
  tenantId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("oauth_clients")
}

model OAuthCode {
  id                  String   @id @default(cuid())
  code                String   @unique
  clientId            String
  tenantId            String
  redirectUri         String?
  codeChallenge       String?
  codeChallengeMethod String?
  expiresAt           DateTime
  createdAt           DateTime @default(now())
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("oauth_codes")
}

model OAuthToken {
  id           String   @id @default(cuid())
  accessToken  String   @unique
  refreshToken String?  @unique
  clientId     String
  tenantId     String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("oauth_tokens")
}

// ─── RBAC & Permissions ──────────────────────────────────────────────

model Permission {
  id              String           @id @default(cuid())
  name            String           @unique
  displayName     String
  description     String?
  category        String
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  granted      Boolean    @default(true)
  tenantId     String?
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId, tenantId])
  @@index([tenantId])
  @@index([roleId])
  @@map("role_permissions")
}

// ─── AI Website Builder (v0 + SaCMS MCP) ─────────────────────────────

model Site {
  id            String             @id @default(cuid())
  tenantId      String
  name          String
  slug          String
  description   String?
  subdomain     String?            @unique
  customDomain  String?
  status        String             @default("draft") // draft | building | published | archived
  framework     String             @default("nextjs")
  previewUrl    String?
  thumbnailUrl  String?
  activeVersion Int                @default(1)
  settings      Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  files         SiteFile[]
  versions      SiteVersion[]
  deployments   SiteDeployment[]
  conversations SiteConversation[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("sites")
}

model SiteFile {
  id        String   @id @default(cuid())
  siteId    String
  path      String
  content   String   @db.Text
  isBinary  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, path])
  @@index([siteId])
  @@map("site_files")
}

model SiteVersion {
  id          String   @id @default(cuid())
  siteId      String
  version     Int
  name        String?
  description String?
  snapshot    Json
  createdAt   DateTime @default(now())
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, version])
  @@index([siteId])
  @@map("site_versions")
}

model SiteDeployment {
  id          String   @id @default(cuid())
  siteId      String
  url         String
  status      String   @default("building") // queued | building | ready | error
  logs        String?  @db.Text
  deployedBy  String?
  createdAt   DateTime @default(now())
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@map("site_deployments")
}

model SiteConversation {
  id        String        @id @default(cuid())
  siteId    String
  title     String        @default("New Conversation")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  site      Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  messages  SiteMessage[]

  @@index([siteId])
  @@map("site_conversations")
}

model SiteMessage {
  id             String           @id @default(cuid())
  conversationId String
  role           String           // user | assistant | system
  content        String           @db.Text
  thought        String?          @db.Text
  toolCalls      Json?
  schemaDiff     Json?
  creditsUsed    Int              @default(0)
  status         String           @default("completed") // streaming | completed | failed
  createdAt      DateTime         @default(now())
  conversation   SiteConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("site_messages")
}

// ─── Enterprise Dedicated Infrastructure (Contabo VPS + PG + MinIO) ───

model InfrastructureServer {
  id                 String                    @id @default(cuid())
  tenantId           String
  subscriptionId     String?
  provider           String                    @default("contabo") // contabo | custom
  providerServerId   String?
  name               String?
  hostname           String?
  ipv4               String?
  ipv6               String?
  region             String                    @default("EU") // EU | US-central | SIN
  plan               String                    @default("vps-s")
  diskGb             Int                       @default(75)
  ramMb              Int                       @default(8192)
  cpuCount           Int                       @default(4)
  status             String                    @default("pending") // pending | provisioning | configuring | active | suspended | error | destroying | destroyed
  errorMessage       String?                   @db.Text
  dbHost             String?
  dbPort             Int                       @default(5432)
  mediaHost          String?
  mediaPort          Int                       @default(443)
  lastHealthCheckAt  DateTime?
  healthStatus       String                    @default("unknown") // healthy | degraded | unhealthy | unknown
  metricsSnapshot    Json?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  tenant             Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  credentials        InfrastructureCredential?

  @@index([tenantId])
  @@index([status])
  @@map("infrastructure_servers")
}

model InfrastructureCredential {
  id                          String               @id @default(cuid())
  serverId                    String               @unique
  databaseName                String               @default("sacms_db")
  dbUser                      String               @default("sacms_user")
  dbPasswordEncrypted         String               @db.Text
  minioUser                   String               @default("sacms_storage")
  minioSecretEncrypted        String               @db.Text
  connectionStringEncrypted   String               @db.Text
  s3Endpoint                  String
  s3Bucket                    String               @default("sacms-media")
  s3PublicUrl                 String?
  createdAt                   DateTime             @default(now())
  rotatedAt                   DateTime?
  server                      InfrastructureServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@map("infrastructure_credentials")
}

// ─── Customer Support & IT Helpdesk ───────────────────────────────────

model SupportTicket {
  id           String           @id @default(cuid())
  tenantId     String?
  userId       String
  subject      String
  category     String           @default("general") // general | billing | technical | infrastructure | domain
  priority     String           @default("normal")  // low | normal | high | urgent
  status       String           @default("open")    // open | in_progress | resolved | closed
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  
  tenant       Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     SupportMessage[]

  @@index([tenantId, status])
  @@index([userId])
  @@map("support_tickets")
}

model SupportMessage {
  id          String        @id @default(cuid())
  ticketId    String
  senderId    String
  senderRole  String        @default("user") // user | admin | system
  message     String        @db.Text
  attachments Json?         // Array of file metadata or URLs
  isRead      Boolean       @default(false)
  createdAt   DateTime      @default(now())

  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("support_messages")
}

// ─── Multi-Tenant End-User Members & Headless Auth ──────────────────

model Member {
  id            String          @id @default(cuid())
  tenantId      String
  email         String
  passwordHash  String
  name          String?
  avatar        String?
  role          String          @default("authenticated") // slug of MemberRole (public | authenticated | custom slugs)
  status        String          @default("active") // active | suspended | pending_verification
  emailVerified DateTime?
  metadata      Json?           // Custom attributes (e.g. phone, address, preferences)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  lastLoginAt   DateTime?
  passwordResetToken   String?  @unique
  passwordResetExpires DateTime?
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions      MemberSession[]

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([tenantId, role])
  @@map("members")
}

model MemberSession {
  id           String    @id @default(cuid())
  memberId     String
  tenantId     String
  refreshToken String    @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  member       Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([tenantId])
  @@map("member_sessions")
}

// ─── Strapi-parity: Users & Permissions Plugin (MemberRole) ─────────

/// A role scoped to a single tenant (e.g. "Public", "Authenticated", "VIP Member")
model MemberRole {
  id          String                 @id @default(cuid())
  tenantId    String
  name        String                 // Human label e.g. "VIP Member"
  slug        String                 // Identifier e.g. "vip-member"
  description String?
  isSystem    Boolean                @default(false) // true = public | authenticated (cannot delete)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions MemberRolePermission[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("member_roles")
}

/// Granular permission granted to a MemberRole for a content-type and action
/// action: find | findOne | create | update | delete
model MemberRolePermission {
  id            String     @id @default(cuid())
  memberRoleId  String
  contentTypeSlug String   // slug of ContentType, or "*" = all
  action        String     // find | findOne | create | update | delete
  granted       Boolean    @default(true)
  conditions    Json?      // Optional: field-level or ownership conditions
  createdAt     DateTime   @default(now())
  memberRole    MemberRole @relation(fields: [memberRoleId], references: [id], onDelete: Cascade)

  @@unique([memberRoleId, contentTypeSlug, action])
  @@index([memberRoleId])
  @@map("member_role_permissions")
}
